  "open_questions": [
    {
      "id": "Q1",
      "question": "Is a child of exactly 12 months in the 40-breaths group? We read \"2 months up to 12 months\" as excluding 12, so 12 months uses 40.",
      "affects": [
        "fast_breathing"
      ],
      "route_to": "clinician",
      "status": "open",
      "source": {
        "page": 8,
        "quote": "In a child age 12 months up to 5 years, 40 breaths or more per minute"
      }
    },
    {
      "id": "Q2",
      "question": "The guideline covers 2 months up to 5 years only. We refer out-of-range children urgently if they have a danger sign (R1) and routinely otherwise (R2), with no medicine. Is that right?",
      "affects": [
        "R1",
        "R2",
        "refer_urgent_outside_age_range",
        "refer_outside_age_range"
      ],
      "route_to": "clinician",
      "status": "open",
      "source": {
        "page": 3,
        "quote": "child age 2 months up to 5 years"
      }
    },
    {
      "id": "Q3",
      "question": "The guideline gives no treatment row for cough without fast breathing. What should the health worker do, and is there a follow-up?",
      "affects": [
        "cough_no_fast_breathing",
        "R6"
      ],
      "route_to": "clinician",
      "status": "open",
      "source": {
        "page": 8,
        "quote": "Cough (less than 14 days)"
      }
    },
    {
      "id": "Q4",
      "question": "This form asks only cough-related and general danger signs. Diarrhoea, fever, MUAC and feet-swelling danger signs live in other pathways. Is it safe to deploy the cough form alone?",
      "affects": [
        "danger_sign"
      ],
      "route_to": "clinician",
      "status": "open",
      "source": {
        "page": 6,
        "quote": "Diarrhoea for 14 days or more"
      }
    },
    {
      "id": "Q5",
      "question": "How many days should the follow-up task stay open after it is due? The guideline gives the due day only.",
      "affects": [
        "treat_fast_breathing_at_home"
      ],
      "route_to": "program_officer",
      "status": "open"
    },
    {
      "id": "Q6",
      "question": "Entry limits (age 0 to 120 months, breaths 10 to 120, cough 0 to 365 days) are our choice. Are they sensible?",
      "affects": [
        "age_months",
        "breaths_per_minute",
        "cough_days"
      ],
      "route_to": "clinician",
      "status": "open"
    }
  ]
