# Backend API base URL (Vite reads this at dev and build time).
# Deployed HTTP API, stage $default, so no stage path. Its CORS allows http://localhost:5173.
# Override per command: VITE_API_URL=http://localhost:8787 npm run dev (local dev:local backend),
# or VITE_API_URL= npm run dev (empty: built-in sample data, no backend).
VITE_API_URL=https://7dben4c860.execute-api.us-west-2.amazonaws.com
