# Backend API base URL (Vite reads this at dev and build time).
# Deployed HTTP API, stage $default, so no stage path. Its CORS allows http://localhost:5173.
# Override per command: VITE_API_URL=http://localhost:8787 npm run dev (local dev:local backend),
# or VITE_API_URL= npm run dev (empty: built-in sample data, no backend).
VITE_API_URL=https://871a8zkm18.execute-api.us-west-2.amazonaws.com
# Sign-in (Cognito, DEC-015): after a deploy with sign-in, set these from the OrchestratorLambdaStack outputs
# AUTHDOMAIN and USERPOOLCLIENTID. Empty: no sign-in in the app (sample mode, or a backend deployed with -c auth=off).
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
