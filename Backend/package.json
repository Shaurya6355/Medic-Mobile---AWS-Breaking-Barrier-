{
  "name": "orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/compiler/template','dist/compiler/template',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "compile:demo": "tsx compile-demo/run.mjs",
    "compile:preview": "node compile-demo/preview/cli.mjs preview",
    "compile:screenshots": "node compile-demo/preview/cli.mjs screenshots",
    "compile:verify": "tsx compile-demo/preview/verify-golden.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1161.0",
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-sqs": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@strands-agents/sdk": "^1.23.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "jszip": "^3.10.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "aws-sdk-client-mock": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
