# Template only. Copy to Backend/.env and fill in. No secrets or AWS keys belong in this file:
# credentials come from your AWS SSO profile or the runtime IAM role, never from here.
# Table, bucket and queue values come from the `cdk deploy` outputs of Infra/ (see Infra/README.md).
AWS_REGION=us-west-2
TABLE_RUNS=
TABLE_STEPS=
TABLE_VERSIONS=
TABLE_COMMENTS=
TABLE_AUDIT=
ARTIFACT_BUCKET=
# Required when RUN_MODE=container; not used when RUN_MODE=agentcore or lambda.
UPLOAD_QUEUE_URL=
# container (default), agentcore or lambda. See "Running on AgentCore" and "Running on Lambda" in README.md.
RUN_MODE=container
MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
PORT=8080
# Optional: PRICES_JSON={"us.anthropic.claude-sonnet-4-5-20250929-v1:0":{"inPerMTok":3,"outPerMTok":15}}
# bedrock (default: Strands runs in this process) or agentcore (Strands runs on an AgentCore Runtime; MODEL_ID is passed to it).
MODEL_BACKEND=bedrock
# Required only when MODEL_BACKEND=agentcore, e.g. arn:aws:bedrock-agentcore:us-west-2:123456789012:runtime/<id>
AGENTCORE_RUNTIME_ARN=
# Optional: largest input PDF ingest downloads, in bytes (default 52428800), and MAX_PAGES (default 200).
MAX_PDF_BYTES=
